# =============================================================================
# new-api 生产部署 · 环境变量模板
#
# remote_bootstrap.sh 首次部署会从本文件生成 .env，并自动填充随机密钥。
# =============================================================================

DATA_ROOT=/home/work/data
NEW_API_PORT=3000
NODE_NAME=new-api-prod-1

# PostgreSQL（容器名 postgres，网络 new_api_infra_net）
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=new-api

# Redis
REDIS_PASSWORD=CHANGE_ME

# new-api 必填
SESSION_SECRET=CHANGE_ME
