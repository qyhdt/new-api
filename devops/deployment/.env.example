# =============================================================================
# new-api 生产部署 · 环境变量模板
#
# remote_bootstrap.sh 首次部署会从本文件生成 .env，并自动填充随机密钥。
# =============================================================================

DATA_ROOT=/home/work/data
NEW_API_PORT=3000
NODE_NAME=new-api-prod-1

# 公网域名（edge-nginx 终止 TLS，反代到容器 new-api:3000；多个域名在 nginx.conf server_name 配置）
EDGE_DOMAIN=aiapi.thyseed.com
EDGE_DOMAIN_ALT=aicenter.thyseed.com
# 留空：由 new-api 容器同源提供前端（推荐）；若前后端分离再填完整 URL
FRONTEND_BASE_URL=

# PostgreSQL（容器名 postgres，网络 new_api_infra_net）
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=new-api

# Redis
REDIS_PASSWORD=CHANGE_ME

# new-api 必填
SESSION_SECRET=CHANGE_ME

# Thyseed 门户 SSO（JWT_SECRET 必须与 thyseed-sso-app 线上 .env 完全一致）
THYSEED_SSO_ENABLED=true
JWT_SECRET=thyseed-local-dev-secret-change-me-32bytes
THYSEED_SSO_PORTAL_URL=https://portal.thyseed.com
THYSEED_SSO_API_ORIGIN=https://portalapi.thyseed.com
THYSEED_SSO_AUTO_REGISTER=true
THYSEED_SSO_DEFAULT_ROLE=1
