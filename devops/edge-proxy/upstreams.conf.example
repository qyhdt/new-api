# 运行时复制到 /home/work/data/runtime/edge-proxy/upstreams.conf
# 勿用 upstream { server new-api:3000; } 静态块——容器未就绪时 nginx 会 [emerg] 起不来。
# 使用变量 + resolver 127.0.0.11 在请求时再解析（与 thyseed-platform 一致）。

# 单实例（默认）
map "" $new_api_upstream_host {
    default new-api;
}

